# SMTP CONFIG #
smtp_relay_host=mailhog
smtp_relay_port=1025
# true, because smtp.yandex.ru relay is an external(not a internal bank service) service
is_external_smtp_relay=True
email_login=efwefweffwewfe@yandex.ru
email_password=efwefweffwewfe1
enable_authentication=False

# CELERY CONFIG #
celery_broker_url=redis://redis:6379/0
celery_result_backend=redis://redis:6379/1
celery_launch_command="celery -f ../logs/log-celery -A app.mail.celery worker -l info -c4 &"

task_soft_time_limit=300
task_time_limit=600
max_retries=10
time_to_retries=180
time_to_retries_range=30

# NOTIFICATION SERVICE CONFIG #
notify_path_to_log=/app/logs/log-notification

# REDIS CONFIG #
redis_host=redis
redis_port=6379
redis_healthcheck_interval=30
redis_message_ttl=43200

# CACHE CONFIG #
cache_prefix=notification-service